#!/usr/bin/env python3
"""Strict v2.1.1 private-server fixture (no V1 routes or event payloads)."""
import argparse
import base64
import copy
import http.server
import json
import os
import queue
import signal
import sys
import threading
import time
import urllib.parse

SESSIONS = {}
MESSAGES = {}
ABORTED = {}
SUBSCRIBERS = []
LOCK = threading.Lock()
COUNTER = 0


def record(name, value):
    with open(".opencode-chat-" + name + ".jsonl", "a", encoding="utf-8") as stream:
        stream.write(json.dumps(value, ensure_ascii=False) + "\n")


def emit(typ, session_id, **data):
    event = {"id": str(time.time_ns()), "type": typ, "data": {"sessionID": session_id, **data}}
    with LOCK:
        for subscriber in SUBSCRIBERS:
            subscriber.put(event)


def create(payload):
    global COUNTER
    with LOCK:
        COUNTER += 1
        session_id = f"test-session-{os.getpid()}-{COUNTER}"
        session = {"id": session_id, "title": payload.get("title", session_id), "location": payload["location"], "model": payload.get("model"), "agent": payload.get("agent")}
        SESSIONS[session_id] = session
        MESSAGES[session_id] = []
        ABORTED[session_id] = threading.Event()
    return session


class Handler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def authorized(self):
        expected = "Basic " + base64.b64encode(("opencode:" + os.environ["OPENCODE_PASSWORD"]).encode()).decode()
        if self.headers.get("Authorization") != expected:
            self.respond({"error": "unauthorized"}, 401)
            return False
        return True

    def route(self):
        return urllib.parse.urlparse(self.path).path.split("/")[1:]

    def body(self):
        return json.loads(self.rfile.read(int(self.headers.get("Content-Length", "0"))) or "{}")

    def do_GET(self):
        if not self.authorized(): return
        route = self.route()
        if route == ["api", "info"]:
            return self.respond({"version": "2.1.1"})
        if route == ["api", "event"]:
            return self.events()
        if route == ["api", "session"]:
            directory = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query).get("directory", [None])[0]
            record("list", {"directory": directory})
            # Deliberately return a foreign item too: caller must fail closed.
            items = list(SESSIONS.values()) + [
                {"id": "foreign-session", "title": "Other workspace", "location": {"directory": "/other-workspace"}},
                {"id": "subagent-session", "title": "Build (@runner subagent)", "parentID": "parent", "location": {"directory": os.getcwd()}},
            ]
            return self.page(items)
        if len(route) >= 3 and route[:2] == ["api", "session"]:
            session_id = route[2]
            if session_id not in SESSIONS: return self.respond({}, 404)
            if len(route) == 3: return self.respond({"data": SESSIONS[session_id]})
            if route[3:] == ["message"]:
                return self.page(MESSAGES[session_id])
        return self.respond({}, 404)

    def do_POST(self):
        if not self.authorized(): return
        route, data = self.route(), self.body()
        if route == ["api", "session"]:
            if not data.get("location", {}).get("directory"): return self.respond({}, 400)
            session = create(data)
            record("session", data)
            return self.respond({"data": session})
        if len(route) != 4 or route[:2] != ["api", "session"]: return self.respond({}, 404)
        session_id, action = route[2:]
        if session_id not in SESSIONS: return self.respond({}, 404)
        if action == "fork":
            if not MESSAGES[session_id]: return self.respond({"message": "empty_session"}, 400)
            source = SESSIONS[session_id]
            session = create(source)
            MESSAGES[session["id"]] = copy.deepcopy(MESSAGES[session_id])
            record("fork", {"source": session_id, "id": session["id"]})
            return self.respond({"data": session})
        if action in ("agent", "model"):
            if action == "model" and data["model"]["id"] == "invalid-model":
                return self.respond({"message": "unknown model"}, 400)
            SESSIONS[session_id][action] = data[action]
            record(action, {"sessionID": session_id, **data})
            return self.respond(None, 204)
        if action == "interrupt":
            if MESSAGES[session_id] and "cancel failure" in MESSAGES[session_id][-1].get("text", ""):
                return self.respond({"message": "interrupt failed"}, 500)
            ABORTED[session_id].set()
            record("abort", {"sessionID": session_id})
            emit("session.execution.interrupted", session_id, reason="user")
            return self.respond({"interrupted": True})
        if action == "prompt":
            if "text" not in data or "parts" in data or "model" in data: return self.respond({}, 400)
            inbox_id = f"msg-{time.time_ns()}"
            MESSAGES[session_id].append({"id": inbox_id, "type": "user", "text": data["text"]})
            record("prompt", data)
            ABORTED[session_id].clear()
            if "admission race" in data["text"]: time.sleep(0.3)
            self.respond({"data": {"id": inbox_id, "text": data["text"], "type": "user"}})
            threading.Thread(target=self.reply, args=(session_id, data["text"]), daemon=True).start()
            return
        return self.respond({}, 404)

    def do_DELETE(self):
        if not self.authorized(): return
        route = self.route()
        if len(route) == 5 and route[:2] == ["api", "session"] and route[3] == "inbox":
            record("inbox-cancel", {"sessionID": route[2], "id": route[4]})
            return self.respond(None, 204)
        if len(route) == 3 and route[:2] == ["api", "session"]:
            session_id = route[2]
            SESSIONS.pop(session_id, None)
            MESSAGES.pop(session_id, None)
            record("delete", {"sessionID": session_id})
            return self.respond(None, 204)
        return self.respond({}, 404)

    def do_PATCH(self):
        if not self.authorized(): return
        route, data = self.route(), self.body()
        if len(route) == 3 and route[2] in SESSIONS:
            SESSIONS[route[2]]["title"] = data["title"]
            record("rename", {"sessionID": route[2], "title": data["title"]})
            return self.respond(None, 204)
        return self.respond({}, 404)

    def respond(self, value, status=200):
        payload = b"" if status == 204 else json.dumps(value, ensure_ascii=False).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)
        self.wfile.flush()

    def page(self, items):
        query = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
        start = int(query.get("cursor", ["0"])[0])
        end = start + 2
        return self.respond({"data": items[start:end], "cursor": {"next": str(end)} if end < len(items) else {}})

    def events(self):
        record("events", {"path": self.path})
        subscriber = queue.Queue()
        with LOCK: SUBSCRIBERS.append(subscriber)
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Transfer-Encoding", "chunked")
        self.end_headers()
        def write(payload):
            self.wfile.write(f"{len(payload):x}\r\n".encode() + payload + b"\r\n")
            self.wfile.flush()
        try:
            write(b'data: {"type":"server.connected","data":{}}\n\n')
            while True:
                try: event = subscriber.get(timeout=0.5)
                except queue.Empty:
                    write(b": heartbeat\n\n")
                    continue
                if event.get("__drop"):
                    self.wfile.write(b"0\r\n\r\n"); self.wfile.flush()
                    return
                write(b"data: " + json.dumps(event, ensure_ascii=False).encode() + b"\n\n")
        except (BrokenPipeError, ConnectionResetError): pass
        finally:
            with LOCK: SUBSCRIBERS.remove(subscriber)

    def reply(self, session_id, text):
        emit("session.execution.started", session_id)
        # Unrelated idle must not complete this request.
        emit("session.status", "foreign-session", status={"type": "idle"})
        if "slow response" in text and ABORTED[session_id].wait(5): return
        if "partial response" in text: time.sleep(0.5)
        if ABORTED[session_id].is_set(): return
        if "backend failure" in text:
            emit("session.execution.failed", session_id, error={"message": "fixture execution failed"})
            return
        if "reasoning test" in text:
            emit("session.reasoning.delta", session_id, delta="hidden thinking")
        reply = "fake reply: " + text
        if "make add subtract" in text or "改成减法" in text:
            target = os.path.join(SESSIONS[session_id]["location"]["directory"], "src", "example.lua")
            with open(target, encoding="utf-8") as stream: content = stream.read()
            with open(target, "w", encoding="utf-8") as stream: stream.write(content.replace("return a + b", "return a - b"))
            reply = "已改好：src/example.lua 中 M.add(a, b) 现在返回 a - b。"
        assistant_id = "msg-" + str(time.time_ns())
        if "disconnect recovery" in text:
            emit("session.text.delta", session_id, assistantMessageID=assistant_id, ordinal=0, delta=reply[:5])
            with LOCK:
                for subscriber in SUBSCRIBERS: subscriber.put({"__drop": True})
            time.sleep(0.1)
        for chunk in [reply[:10], reply[10:25], reply[25:]]:
            emit("session.text.delta", session_id, assistantMessageID=assistant_id, ordinal=0, delta=chunk)
            time.sleep(0.03)
        emit("session.text.ended", session_id, assistantMessageID=assistant_id, ordinal=0, text=reply)
        MESSAGES.setdefault(session_id, []).extend([
            {"id": assistant_id, "type": "assistant", "content": [{"type": "text", "text": reply}]},
            {"id": "idle-" + str(time.time_ns()), "type": "idle"},
        ])
        emit("session.execution.succeeded", session_id)
        emit("session.status", session_id, status={"type": "idle"})

    def log_message(self, *_args): pass


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("command", choices=["serve"])
    parser.add_argument("--stdio", action="store_true", required=True)
    parser.add_argument("--port", type=int, default=0)
    parser.add_argument("--hostname", default="127.0.0.1")
    args = parser.parse_args()
    if not os.environ.get("OPENCODE_PASSWORD"): raise SystemExit("password required")
    server = http.server.ThreadingHTTPServer((args.hostname, args.port), Handler)
    server.daemon_threads = True
    record("start", {"pid": os.getpid(), "port": server.server_port})
    # Split readiness across writes, as real job callbacks may do.
    ready = json.dumps({"url": f"http://{args.hostname}:{server.server_port}"})
    sys.stdout.write(ready[:8]); sys.stdout.flush()
    time.sleep(0.02)
    print(ready[8:], flush=True)
    def lease():
        sys.stdin.buffer.read()
        record("eof", {"pid": os.getpid()})
        os._exit(0)
    threading.Thread(target=lease, daemon=True).start()
    signal.signal(signal.SIGTERM, lambda *_: os._exit(0))
    server.serve_forever()


if __name__ == "__main__": main()
