#!/usr/bin/env python3
import argparse
import http.server
import json
import os
import re
import signal
import sys


SESSION_ID = "test-session"


class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/app":
            self.send_response(200)
            self.end_headers()
            self.wfile.write(b"ok")
            return
        self.send_response(404)
        self.end_headers()

    def do_POST(self):
        length = int(self.headers.get("content-length", "0"))
        body = self.rfile.read(length).decode("utf-8")
        data = json.loads(body) if body else {}

        if self.path == "/api/session":
            self._json({"id": SESSION_ID, "directory": data.get("directory")})
            return

        if re.match(r"^/api/session/[^/]+/prompt$", self.path):
            text = data.get("prompt", {}).get("text", "")
            with open(os.path.join(os.getcwd(), ".opencode-chat-prompt.jsonl"), "a", encoding="utf-8") as f:
                f.write(json.dumps(data, ensure_ascii=False) + "\n")
            self._json({"message": {"role": "assistant", "text": "fake reply: " + text}})
            return

        self.send_response(404)
        self.end_headers()

    def _json(self, data):
        payload = json.dumps(data, ensure_ascii=False).encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    def log_message(self, *_args):
        return


def main():
    parser = argparse.ArgumentParser()
    subparsers = parser.add_subparsers(dest="command")
    serve = subparsers.add_parser("serve")
    serve.add_argument("--port", type=int, required=True)
    serve.add_argument("--hostname", default="127.0.0.1")
    parser.add_argument("--port", type=int)
    parser.add_argument("--hostname", default="127.0.0.1")
    args = parser.parse_args()

    port = args.port
    host = args.hostname
    if args.command == "serve":
        port = args.port
        host = args.hostname
    if not port:
        raise SystemExit("--port is required")

    server = http.server.ThreadingHTTPServer((host, port), Handler)

    def stop(_signum, _frame):
        os._exit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    server.serve_forever()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(0)
