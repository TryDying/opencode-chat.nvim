#!/usr/bin/env python3
import argparse
import http.server
import json
import os
import queue
import re
import signal
import sys
import threading
import time
import urllib.parse


SESSION_COUNTER = 0
SESSIONS = []
MESSAGES = {}
ABORTED = {}
SUBSCRIBERS = []
SUBSCRIBERS_LOCK = threading.Lock()


def text_part(message_id, text):
    return {"id": message_id + "-part", "type": "text", "text": text}


def user_message(message_id, text):
    return {"info": {"id": message_id, "role": "user", "time": {"created": int(time.time() * 1000)}}, "parts": [text_part(message_id, text)]}


def assistant_message(message_id, text, completed=True, error=None):
    info = {"id": message_id, "role": "assistant", "time": {"created": int(time.time() * 1000)}}
    if completed:
        info["time"]["completed"] = int(time.time() * 1000)
    if error:
        info["error"] = {"message": error}
    return {"info": info, "parts": [text_part(message_id, text)]}


def prompt_text(data):
    return "\n".join(part.get("text", "") for part in data.get("parts", []) if part.get("type") == "text")


class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/app":
            self._text("ok")
            return
        if self.path == "/doc":
            self._json({"openapi": "3.1.0"})
            return
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path == "/event":
            qs = urllib.parse.parse_qs(parsed.query)
            req_dir = qs.get("directory", [None])[0]
            if req_dir:
                expected = os.getcwd()
                if req_dir != expected:
                    debug_log = os.path.join(os.getcwd(), ".opencode-chat-directory-mismatch.txt")
                    with open(debug_log, "w", encoding="utf-8") as f:
                        f.write("requested=%s\nexpected=%s\n" % (req_dir, expected))
            self._events()
            return
        if self.path == "/project":
            self._json({"data": {"projects": [
                {"id": "wrong-project", "worktree": "/tmp/wrong-project"},
                {"id": "test-project", "worktree": os.getcwd()},
            ]}})
            return
        if self.path == "/project/current":
            self._json({"id": "test-project", "worktree": os.getcwd()})
            return
        foreign = {
            "id": "foreign-session",
            "title": "Other workspace session",
            "projectID": "test-project",
            "directory": "/tmp/other-workspace",
        }
        subagent = {
            "id": "subagent-session",
            "title": "Build APK (@runner subagent)",
            "projectID": "test-project",
            "directory": os.getcwd(),
            "parentSessionID": "test-session-1",
        }
        if parsed.path == "/session":
            qs = urllib.parse.parse_qs(parsed.query)
            scope = qs.get("scope", [None])[0]
            path_filter = qs.get("path", [None])[0]
            if scope == "project" and path_filter:
                # Return sessions matching the project scope
                self._json(SESSIONS + [foreign, subagent])
            else:
                self._json(SESSIONS + [foreign, subagent])
            return
        if parsed.path == "/api/session":
            self._json({"data": {"sessions": SESSIONS + [foreign, subagent]}})
            return
        match = re.match(r"^/session/([^/]+)/message$", parsed.path)
        if match:
            messages = MESSAGES.get(match.group(1), [])
            qs = urllib.parse.parse_qs(parsed.query)
            limit_str = qs.get("limit", [None])[0]
            if limit_str:
                try:
                    limit = int(limit_str)
                    if limit > 0:
                        messages = messages[-limit:]
                except ValueError:
                    pass
            self._json(messages)
            return
        self._text("not found", 404)

    def do_PATCH(self):
        length = int(self.headers.get("content-length", "0"))
        body = self.rfile.read(length).decode("utf-8")
        data = json.loads(body) if body else {}
        match = re.match(r"^/session/([^/]+)$", self.path)
        if match:
            session_id = match.group(1)
            for session in SESSIONS:
                if session.get("id") == session_id:
                    if data.get("title"):
                        session["title"] = data.get("title")
                    with open(os.path.join(os.getcwd(), ".opencode-chat-rename.jsonl"), "a", encoding="utf-8") as f:
                        f.write(json.dumps({"sessionID": session_id, "title": session.get("title")}, ensure_ascii=False) + "\n")
                    self._json(session)
                    return
            self._text("not found", 404)
            return
        self._text("not found", 404)

    def do_DELETE(self):
        global SESSIONS, MESSAGES
        match = re.match(r"^/session/([^/?]+)", self.path)
        if match:
            session_id = match.group(1)
            before = len(SESSIONS)
            SESSIONS = [session for session in SESSIONS if session.get("id") != session_id]
            MESSAGES.pop(session_id, None)
            with open(os.path.join(os.getcwd(), ".opencode-chat-delete.jsonl"), "a", encoding="utf-8") as f:
                f.write(json.dumps({"sessionID": session_id}, ensure_ascii=False) + "\n")
            self._json(before != len(SESSIONS))
            return
        self._text("not found", 404)

    def do_POST(self):
        global SESSION_COUNTER, SESSIONS, MESSAGES, ABORTED
        length = int(self.headers.get("content-length", "0"))
        body = self.rfile.read(length).decode("utf-8")
        data = json.loads(body) if body else {}

        if self.path == "/session":
            SESSION_COUNTER += 1
            session_id = f"test-session-{SESSION_COUNTER}"
            ABORTED[session_id] = False
            session = {"id": session_id, "title": data.get("title") or session_id, "projectID": "test-project", "directory": os.getcwd()}
            SESSIONS.append(session)
            MESSAGES.setdefault(session_id, [])
            self._record_session(data)
            self._json(session)
            return

        match = re.match(r"^/session/([^/]+)/prompt_async$", self.path)
        if match:
            session_id = match.group(1)
            if not data.get("model") or not data.get("agent") or not data.get("variant"):
                self._record_prompt(data)
                self._text("bad request", 400)
                return
            text = prompt_text(data)
            self._record_prompt(data)
            self._start_async_reply(session_id, text)
            self._text("", 204)
            return

        match = re.match(r"^/session/([^/]+)/abort$", self.path)
        if match:
            session_id = match.group(1)
            ABORTED[session_id] = True
            with open(os.path.join(os.getcwd(), ".opencode-chat-abort.jsonl"), "a", encoding="utf-8") as f:
                f.write(json.dumps({"sessionID": session_id}, ensure_ascii=False) + "\n")
            self._json({"ok": True})
            return

        self._text("not found", 404)

    def _record_prompt(self, data):
        with open(os.path.join(os.getcwd(), ".opencode-chat-prompt.jsonl"), "a", encoding="utf-8") as f:
            f.write(json.dumps(data, ensure_ascii=False) + "\n")

    def _record_session(self, data):
        with open(os.path.join(os.getcwd(), ".opencode-chat-session.jsonl"), "a", encoding="utf-8") as f:
            f.write(json.dumps(data, ensure_ascii=False) + "\n")

    def _json(self, data, status=200):
        payload = json.dumps(data, ensure_ascii=False).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    def _text(self, text, status=200):
        payload = text.encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    def log_message(self, *_args):
        return

    def _events(self):
        with open(os.path.join(os.getcwd(), ".opencode-chat-events.jsonl"), "a", encoding="utf-8") as f:
            f.write(json.dumps({"path": self.path}, ensure_ascii=False) + "\n")
        subscriber = queue.Queue()
        with SUBSCRIBERS_LOCK:
            SUBSCRIBERS.append(subscriber)
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-cache")
        self.end_headers()
        try:
            self._write_event({"id": "connected", "type": "server.connected", "properties": {}})
            while True:
                try:
                    event = subscriber.get(timeout=10)
                except queue.Empty:
                    event = {"id": "heartbeat", "type": "server.heartbeat", "properties": {}}
                self._write_event(event)
        except (BrokenPipeError, ConnectionResetError):
            pass
        finally:
            with SUBSCRIBERS_LOCK:
                if subscriber in SUBSCRIBERS:
                    SUBSCRIBERS.remove(subscriber)

    def _write_event(self, event):
        payload = json.dumps(event, ensure_ascii=False).encode("utf-8")
        self.wfile.write(b"event: message\n")
        self.wfile.write(b"data: " + payload + b"\n\n")
        self.wfile.flush()

    def _broadcast(self, event):
        with SUBSCRIBERS_LOCK:
            subscribers = list(SUBSCRIBERS)
        for subscriber in subscribers:
            subscriber.put(event)

    def _stream_with_reasoning(self, session_id, thinking_text, reply_text):
        """Simulate a response with reasoning/thinking content before the actual reply."""
        with SUBSCRIBERS_LOCK:
            has_subscribers = bool(SUBSCRIBERS)
        if not has_subscribers:
            return
        # 1. Reasoning part start: message.part.updated (type="reasoning", empty text)
        self._broadcast({
            "id": "reasoning-part-updated-start",
            "type": "message.part.updated",
            "properties": {
                "sessionID": session_id,
                "part": {"id": "reasoning-part-1", "type": "reasoning", "text": ""},
                "time": int(time.time() * 1000),
            },
        })
        # 2. Reasoning deltas (should be filtered by client)
        thinking_chunks = [thinking_text[:15], thinking_text[15:]]
        for index, chunk in enumerate(thinking_chunks):
            if not chunk:
                continue
            self._broadcast({
                "id": f"reasoning-delta-{index}",
                "type": "message.part.delta",
                "properties": {
                    "sessionID": session_id,
                    "messageID": "assistant-message",
                    "partID": "reasoning-part-1",
                    "field": "text",
                    "delta": chunk,
                },
            })
            time.sleep(0.05)
        # 3. Reasoning part end: message.part.updated (type="reasoning", full text)
        self._broadcast({
            "id": "reasoning-part-updated-end",
            "type": "message.part.updated",
            "properties": {
                "sessionID": session_id,
                "part": {"id": "reasoning-part-1", "type": "reasoning", "text": thinking_text},
                "time": int(time.time() * 1000),
            },
        })
        # 4. Now stream the actual text reply via _stream_reply
        self._stream_reply(session_id, reply_text)

    def _stream_reply(self, session_id, text):
        with SUBSCRIBERS_LOCK:
            has_subscribers = bool(SUBSCRIBERS)
        if not has_subscribers:
            return
        # 先发 part 快照，让 SSE client 知道这是 text part（非 reasoning）
        self._broadcast({
            "id": "part-updated-start",
            "type": "message.part.updated",
            "properties": {
                "sessionID": session_id,
                "part": {"id": "assistant-message-part", "type": "text", "text": ""},
                "time": int(time.time() * 1000),
            },
        })
        chunks = [text[:10], text[10:25], text[25:]]
        for index, chunk in enumerate(chunks):
            if not chunk:
                continue
            self._broadcast({
                "id": f"assistant-message-part-{index}",
                "type": "message.part.delta",
                "properties": {
                    "sessionID": session_id,
                    "messageID": "assistant-message-part",
                    "partID": "assistant-message-part",
                    "field": "text",
                    "delta": chunk,
                },
            })
            time.sleep(0.05)
        # 补发完整 part 快照（reasoning-end 对应的 behavior）
        self._broadcast({
            "id": "part-updated-end",
            "type": "message.part.updated",
            "properties": {
                "sessionID": session_id,
                "part": {"id": "assistant-message-part", "type": "text", "text": text},
                "time": int(time.time() * 1000),
            },
        })
        self._broadcast({
            "id": "session-status-idle",
            "type": "session.status",
            "properties": {"sessionID": session_id, "status": {"type": "idle"}},
        })
        self._broadcast({
            "id": "session-idle",
            "type": "session.idle",
            "properties": {"sessionID": session_id},
        })

    def _start_async_reply(self, session_id, text):
        def worker():
            global MESSAGES
            base = len(MESSAGES.get(session_id, []))
            user = user_message(f"user-message-{base + 1}", text)
            MESSAGES.setdefault(session_id, []).append(user)
            if "slow response" in text:
                time.sleep(5)
                if ABORTED.get(session_id):
                    MESSAGES.setdefault(session_id, []).append(assistant_message(f"assistant-message-{base + 2}", "", True, "aborted"))
                    return
            elif "partial response" in text:
                time.sleep(0.5)
                reply_text = "fake reply: " + text
                self._stream_reply(session_id, reply_text)
                current = MESSAGES.setdefault(session_id, [])
                if current and current[-1].get("info", {}).get("role") == "assistant" and not current[-1].get("info", {}).get("time", {}).get("completed"):
                    current[-1] = assistant_message(current[-1]["info"]["id"], reply_text)
                else:
                    current.append(assistant_message(f"assistant-message-{base + 2}", reply_text))
                return
            elif "make add subtract" in text or "改成减法" in text:
                target = os.path.join(os.getcwd(), "src", "example.lua")
                if os.path.exists(target):
                    with open(target, "r", encoding="utf-8") as f:
                        content = f.read()
                    content = content.replace("return a + b", "return a - b")
                    with open(target, "w", encoding="utf-8") as f:
                        f.write(content)
                edit_text = "已改好：src/example.lua 中 M.add(a, b) 现在返回 a - b。"
                time.sleep(0.1)  # give SSE subscriber time to connect
                self._stream_reply(session_id, edit_text)
                MESSAGES.setdefault(session_id, []).append(assistant_message(f"assistant-message-{base + 2}", edit_text))
                return
            elif "reasoning test" in text:
                reply_text = "fake reply: " + text
                thinking_text = "This is hidden thinking content that should NOT appear in the chat UI"
                self._stream_with_reasoning(session_id, thinking_text, reply_text)
                MESSAGES.setdefault(session_id, []).append(assistant_message(f"assistant-message-{base + 2}", reply_text))
                return
            reply_text = "fake reply: " + text
            time.sleep(0.1)  # give SSE subscriber time to connect before streaming
            self._stream_reply(session_id, reply_text)
            current = MESSAGES.setdefault(session_id, [])
            if current and current[-1].get("info", {}).get("role") == "assistant" and not current[-1].get("info", {}).get("time", {}).get("completed"):
                current[-1] = assistant_message(current[-1]["info"]["id"], reply_text)
            else:
                current.append(assistant_message(f"assistant-message-{base + 2}", reply_text))

        threading.Thread(target=worker, daemon=True).start()


def main():
    parser = argparse.ArgumentParser()
    subparsers = parser.add_subparsers(dest="command")
    serve = subparsers.add_parser("serve")
    serve.add_argument("--port", type=int, required=True)
    serve.add_argument("--hostname", default="127.0.0.1")
    parser.add_argument("--port", type=int)
    parser.add_argument("--hostname", default="127.0.0.1")
    args = parser.parse_args()

    port = args.port
    host = args.hostname
    if args.command == "serve":
        port = args.port
        host = args.hostname
    if not port:
        raise SystemExit("--port is required")

    server = http.server.ThreadingHTTPServer((host, port), Handler)

    def stop(_signum, _frame):
        os._exit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    server.serve_forever()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(0)
