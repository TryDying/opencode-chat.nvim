#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

export VIM_PROFILE="basic"
NVIM_INIT="${NVIM_INIT:-${HOME}/.config/nvim/init.lua}"

exec nvim \
  -u "${NVIM_INIT}" \
  --cmd "set runtimepath^=${REPO_ROOT}" \
  --cmd "lua package.path = '${REPO_ROOT}/lua/?.lua;${REPO_ROOT}/lua/?/init.lua;' .. package.path" \
  -c "lua assert(vim.env.VIM_PROFILE == 'basic', 'VIM_PROFILE must be basic')" \
  -c "lua vim.g.loaded_opencode_chat = nil" \
  -c "source ${REPO_ROOT}/plugin/opencode_chat.lua" \
  -c "lua require('opencode_chat').setup({ command = vim.env.OPENCODE_CHAT_COMMAND or 'opencode', keymaps = { toggle = '<M-->', append_context = '<leader>Xe', append_selection = '<M-->', sessions = '<leader>Xl', new_session = '<leader>Xn', models = '<leader>Xm', variants = '<leader>Xt', quick = '<leader>Xq', quick_context = '<leader>XQ' } })" \
  -c "lua vim.notify((vim.env.OPENCODE_CHAT_NOTICE or 'opencode-chat.nvim loaded with real opencode backend') .. ': <M--> toggle, <leader>Xe/Xl/Xn/Xm/Xt/Xq/XQ, input <C-s>; session picker r/d')" \
  "$@"
