#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

exec nvim --clean -u NONE \
  --cmd "set runtimepath^=${REPO_ROOT}" \
  -c "runtime plugin/opencode_chat.lua" \
  -c "lua vim.notify('opencode-chat.nvim loaded: <M--> toggles chat, :OpencodeAsk sends a prompt')" \
  "$@"
