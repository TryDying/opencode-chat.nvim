#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

export OPENCODE_CHAT_COMMAND="${REPO_ROOT}/tests/fixtures/opencode"
export OPENCODE_CHAT_NOTICE="opencode-chat.nvim loaded with fake opencode backend"

exec "${REPO_ROOT}/scripts/dev-sandbox" "$@"
